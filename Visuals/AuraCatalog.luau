-- =============================================================================
-- Fast Indexing & Lookups
-- =============================================================================

local REGISTRY: { [string]: AuraEntry } = {}
local ORDER: { string } = table.create(#AURAS)

for _, aura in ipairs(AURAS) do
	REGISTRY[aura.id] = aura
	table.insert(ORDER, aura.id)
end

table.sort(ORDER, function(a: string, b: string): boolean
	return REGISTRY[a].rarity < REGISTRY[b].rarity
end)

local AuraCatalog = {}

AuraCatalog.AURAS = AURAS
AuraCatalog.ORDER = ORDER
AuraCatalog.Count = #AURAS

function AuraCatalog.Get(id: string): AuraEntry?
	return REGISTRY[id]
end

function AuraCatalog.All(): { [string]: AuraEntry }
	return REGISTRY
end

return AuraCatalog
