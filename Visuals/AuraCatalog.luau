--!strict
--[[
	Visuals.AuraCatalog
	===================
	Comprehensive suite of 66 unique, production-ready Aura specifications
	inspired by Sol's RNG. Covers 9 tiers ranging from Common (1 in 2) to
	Singularity (1 in 100,000,000).

	Every entry provides full procedural parameters:
	  * Identity, odds, and lore
	  * Color palette (RGB triples for pure Luau compatibility)
	  * 3D procedural shard clusters (Block, Ball, Cylinder, Wedge, CornerWedge)
	  * Lissajous / gyroscopic orbit physics
	  * Multi-layer procedural particle emitters
	  * Floor rune & summoning circle styles
	  * Ascension pillar & halo configurations
	  * Cutscene FOV punch, screen flash, and camera shake parameters
]]

export type RGB = { r: number, g: number, b: number }
export type XYZ = { x: number, y: number, z: number }

export type ShardShape = "Ball" | "Block" | "Cylinder" | "Wedge" | "CornerWedge"
export type FloorRuneStyle =
	| "None"
	| "FlameSeal"
	| "FrostGlyph"
	| "VoidRift"
	| "ChronosGear"
	| "CelestialStar"
	| "HolySigil"
	| "DigitalMatrix"
	| "CosmicNebula"
	| "LightningPentagram"
	| "AbyssalWhirlpool"

export type AscensionBeamStyle = "None" | "LightPillar" | "DoubleHelix" | "CosmicBeam" | "GodRay"
export type HaloStyle = "None" | "CrystalCrown" | "GimbalRings" | "SeraphWings" | "OrbitalBelt" | "MatrixCube"
export type SoundProfile = "Common" | "Rare" | "Epic" | "Legendary" | "Mythic" | "Divine" | "Singularity"

export type AuraEntry = {
	id: string,
	displayName: string,
	tier: string,
	rarity: number, -- "1 in rarity"
	subtitle: string,
	tierColor: RGB,

	-- Palette
	primary: RGB,
	secondary: RGB,
	rim: RGB,
	lightColor: RGB,
	lightRange: number,
	lightBrightness: number,

	-- 3D Shards
	shardCount: number,
	shardShape: ShardShape,
	shardSize: XYZ,
	shardSpin: number,

	-- Orbit Geometry
	orbitRadius: number,
	orbitHeight: number,
	orbitSpeed: number,
	tiltDegrees: number,
	precessionSpeed: number,
	harmonicFrequency: number,
	harmonicRatioA: number,
	lissajousAmplitude: number,

	-- Trail
	trailEnabled: boolean,
	trailLifetime: number,
	trailWidthStart: number,
	trailWidthEnd: number,
	trailTransparencyStart: number,
	trailLightEmission: number,

	-- Particles
	particleLayers: number,
	particleRate: number,
	particleSpeedMin: number,
	particleSpeedMax: number,
	particleLifetimeMin: number,
	particleLifetimeMax: number,
	particleSizeStart: number,
	particleSizeEnd: number,
	particleTransparencyStart: number,
	particleSpread: number,
	particleLightEmission: number,
	particleTexture: string,
	smokeTexture: string,

	-- Highlight
	highlightFillTransparency: number,
	highlightOutlineTransparency: number,
	alwaysOnTop: boolean,

	-- Cutscene & Audio
	cutsceneIntensity: number,
	cutsceneShakeMagnitude: number,
	soundProfile: SoundProfile,

	-- Visual Suite Hooks
	floorRuneStyle: FloorRuneStyle,
	ascensionBeamStyle: AscensionBeamStyle,
	haloStyle: HaloStyle,
}

