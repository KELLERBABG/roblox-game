          <string name="Name">AuraRegistry</string>
          <string name="Source"><![CDATA[--!strict
--[[
	AuraRegistry
	============
	The single source of truth for every Aura in the game.

	DESIGN NOTES
	------------
	* This module is PURE LUAU. It performs zero `game`/`Instance` access and
	  builds zero Roblox datatypes at module scope. Colours are stored as
	  0-255 integer triples and sizes as plain { x, y, z } tables, which lets
	  `RollMath` (and this file) load unchanged inside Lune / the Luau CLI.
	* Roblox datatypes are produced on demand by `AuraRegistry.Materialize(id)`,
	  which converts the declarative numbers into real Color3 / ColorSequence /
	  NumberSequence / NumberRange / Vector3 / Enum values exactly once and then
	  caches the result. The client VFX engine only ever reads materialized auras.
	* Nothing in this project depends on a hand authored ScreenGui, mesh, texture
	  or particle - every visual is generated from the numbers below.
	* All textures referenced are engine-shipped `rbxasset://` textures that ship
	  with the Roblox client, so the "zero external assets" contract holds.
]]

export type RGB = { r: number, g: number, b: number }
export type XYZ = { x: number, y: number, z: number }

export type ShardShape = "Ball" | "Block" | "Cylinder" | "Wedge" | "CornerWedge"

export type AuraConfig = {
	-- ===== identity & odds =================================================
	id: string,
	displayName: string,
	tier: string,
	rarity: number, -- "1 in rarity"
	tierColor: RGB,

	-- ===== palette =========================================================
	primary: RGB,
	secondary: RGB,
	rim: RGB,

	-- ===== orbiting shard cluster ==========================================
	shardCount: number,
	shardShape: ShardShape,
	shardSize: XYZ,
	shardSpin: number, -- radians per second of per-shard self spin

	-- ===== orbit geometry (Lissajous / gyroscopic) ==========================
	orbitRadius: number,
	orbitHeight: number, -- vertical harmonic amplitude
	orbitSpeed: number, -- ring angular speed, radians per second
	tiltDegrees: number, -- ring plane tilt
	precessionSpeed: number, -- gyroscopic precession of the ring, radians/s
	harmonicFrequency: number, -- vertical harmonic frequency ratio
	harmonicRatioA: number, -- horizontal harmonic ratio
	lissajousAmplitude: number, -- orbit radius "breathing" amplitude

	-- ===== trail ==========================================================
	trailEnabled: boolean,
	trailLifetime: number,
	trailWidthStart: number,
	trailWidthEnd: number,
	trailTransparencyStart: number,
	trailLightEmission: number,

	-- ===== particle layers =================================================
	particleLayers: number, -- 2 or 3 layered emitters
	particleRate: number, -- particles/second for the core layer
	particleSpeedMin: number,
	particleSpeedMax: number,
	particleLifetimeMin: number,
	particleLifetimeMax: number,
	particleSizeStart: number,
	particleSizeEnd: number,
	particleTransparencyStart: number,
	particleSpread: number, -- degrees
	particleLightEmission: number,
	particleTexture: string,
	smokeTexture: string,

	-- ===== procedural light ================================================
	lightColor: RGB,
	lightRange: number,
	lightBrightness: number,

	-- ===== highlight ======================================================
	highlightFillTransparency: number,
	highlightOutlineTransparency: number,
	alwaysOnTop: boolean,

	-- ===== roll cutscene ==================================================
	cutsceneIntensity: number, -- 0..1, scales FOV punch + colour flash
	cutsceneShakeMagnitude: number, -- studs of camera shake
}

export type MaterializedAura = {
	config: AuraConfig,
	primary: Color3,
	secondary: Color3,
	rim: Color3,

	shardSize: Vector3,
	shardPartType: Enum.PartType,
	shardColorA: Color3,
	shardColorB: Color3,

	trailColor: ColorSequence,
	trailWidth: NumberSequence,
	trailTransparency: NumberSequence,

	particleColor: ColorSequence,
	particleSize: NumberSequence,
	particleTransparency: NumberSequence,
	particleSpeed: NumberRange,
	particleLifetime: NumberRange,

	lightColor: Color3,
	highlightDepthMode: Enum.HighlightDepthMode,
	cutsceneFovDelta: number,
}

-- Engine-shipped textures only. These ship with the Roblox client itself.
local TEX_SPARKLE: string = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_SMOKE: string = "rbxasset://textures/particles/smoke_main.dds"

local AURAS: { AuraConfig } = {
	{
		id = "Ember",
		displayName = "Ember",
		tier = "Common",
		rarity = 2,
		tierColor = { r = 176, g = 186, b = 200 },

		primary = { r = 255, g = 122, b = 42 },
		secondary = { r = 128, g = 42, b = 12 },
		rim = { r = 255, g = 88, b = 0 },

		shardCount = 3,
		shardShape = "Block",
		shardSize = { x = 0.34, y = 0.34, z = 0.34 },
		shardSpin = 1.6,

		orbitRadius = 2.6,
		orbitHeight = 0.55,
		orbitSpeed = 1.4,
		tiltDegrees = 18,
		precessionSpeed = 0.35,
		harmonicFrequency = 3,
		harmonicRatioA = 1,
		lissajousAmplitude = 0.18,

		trailEnabled = true,
		trailLifetime = 0.35,
		trailWidthStart = 0.9,
		trailWidthEnd = 0,
		trailTransparencyStart = 0.25,
		trailLightEmission = 0.8,

		particleLayers = 2,
		particleRate = 10,
		particleSpeedMin = 1.2,
		particleSpeedMax = 2.6,
		particleLifetimeMin = 0.45,
		particleLifetimeMax = 0.9,
		particleSizeStart = 0.32,
		particleSizeEnd = 0,
		particleTransparencyStart = 0.25,
		particleSpread = 25,
		particleLightEmission = 0.6,
		particleTexture = TEX_SPARKLE,
		smokeTexture = TEX_SMOKE,

		lightColor = { r = 255, g = 120, b = 40 },
		lightRange = 8,
		lightBrightness = 1.1,

		highlightFillTransparency = 0.85,
		highlightOutlineTransparency = 0.55,
		alwaysOnTop = false,

		cutsceneIntensity = 0.08,
		cutsceneShakeMagnitude = 0.05,
