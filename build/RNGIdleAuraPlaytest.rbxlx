})
addCorner(topPanel, 14)
addStroke(topPanel, THEME.stroke, 1.3, 0.4)
addGradient(topPanel, THEME.panelRaised, THEME.panel, 90)

makeLabel(topPanel, {
	Name = "Title",
	Position = UDim2.fromOffset(16, 10),
	Size = UDim2.new(1, -32, 0, 14),
