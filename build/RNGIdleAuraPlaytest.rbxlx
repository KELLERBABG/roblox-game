		shardSize = { x = 0.26, y = 0.26, z = 0.95 },
		shardSpin = 2.8,

		orbitRadius = 3.9,
		orbitHeight = 1.1,
		orbitSpeed = 2.3,
		tiltDegrees = 40,
		precessionSpeed = 0.8,
		harmonicFrequency = 6,
