	TextSize = 12,
	TextColor3 = THEME.textDim,
	Font = Enum.Font.GothamBold,
})

local pityLabel = makeLabel(topPanel, {
	Name = "PityLabel",
	Position = UDim2.fromOffset(16, 26),
	Size = UDim2.new(1, -32, 0, 20),
	Text = "Rolls until Guaranteed Rare: 0/100",
	TextSize = 15,
