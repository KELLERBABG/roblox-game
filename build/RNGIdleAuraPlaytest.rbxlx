-- =============================================================================
-- Derived indexes (built once at module load).
-- =============================================================================

local REGISTRY: { [string]: AuraConfig } = {}
for _, aura in ipairs(AURAS) do
	REGISTRY[aura.id] = aura
end

local ORDER: { string } = table.create(#AURAS)
for _, aura in ipairs(AURAS) do
	table.insert(ORDER, aura.id)
end

-- Ascending rarity => ascending "coolness". Used by UI grids and odds tables.
table.sort(ORDER, function(left: string, right: string): boolean
	return REGISTRY[left].rarity < REGISTRY[right].rarity
end)

local TIER_THRESHOLDS: { { maxRarity: number, tier: string, color: RGB } } = {
	{ maxRarity = 2, tier = "Common", color = { r = 176, g = 186, b = 200 } },
	{ maxRarity = 10, tier = "Uncommon", color = { r = 124, g = 222, b = 140 } },
	{ maxRarity = 60, tier = "Rare", color = { r = 104, g = 160, b = 255 } },
	{ maxRarity = 600, tier = "Epic", color = { r = 186, g = 124, b = 255 } },
	{ maxRarity = 6000, tier = "Legendary", color = { r = 255, g = 178, b = 72 } },
	{ maxRarity = math.huge, tier = "Mythic", color = { r = 255, g = 236, b = 160 } },
}

local materializedCache: { [string]: MaterializedAura } = {}
local shardShapeCache: { [string]: Enum.PartType }? = nil

-- Built lazily: `Enum` does not exist outside Roblox, and this module must stay
-- loadable from Lune / the Luau CLI for terminal testing.
local function resolveShardShapes(): { [string]: Enum.PartType }
	local cached = shardShapeCache
	if cached ~= nil then
		return cached
	end

	local resolved: { [string]: Enum.PartType } = {
		Ball = Enum.PartType.Ball,
		Block = Enum.PartType.Block,
		Cylinder = Enum.PartType.Cylinder,
		Wedge = Enum.PartType.Wedge,
		CornerWedge = Enum.PartType.CornerWedge,
	}
	shardShapeCache = resolved
	return resolved
end

-- =============================================================================
-- Public API
-- =============================================================================

local AuraRegistry = {}

AuraRegistry.ORDER = ORDER
AuraRegistry.Count = #AURAS

function AuraRegistry.All(): { [string]: AuraConfig }
	return REGISTRY
end

function AuraRegistry.Get(id: string): AuraConfig?
	return REGISTRY[id]
end

-- Same as Get, but raises with a useful message instead of silently returning nil.
function AuraRegistry.Expect(id: string): AuraConfig
	local config = REGISTRY[id]
	if config == nil then
		error(string.format("AuraRegistry.Expect: unknown aura id %q", tostring(id)), 2)
	end
	return config
end

function AuraRegistry.HighestRarity(): number
	local highest = 0
	for _, aura in ipairs(AURAS) do
		if aura.rarity > highest then
			highest = aura.rarity
		end
	end
	return highest
end

function AuraRegistry.TierOf(rarity: number): string
	for _, band in ipairs(TIER_THRESHOLDS) do
		if rarity <= band.maxRarity then
			return band.tier
		end
	end
	return "Mythic"
end

function AuraRegistry.TierColorOf(rarity: number): RGB
	for _, band in ipairs(TIER_THRESHOLDS) do
		if rarity <= band.maxRarity then
			return band.color
		end
	end
	return TIER_THRESHOLDS[#TIER_THRESHOLDS].color
end

-- Returns every aura id whose rarity is at least `minRarity`, rarest last.
function AuraRegistry.RarityAtLeast(minRarity: number): { string }
	local result: { string } = {}
	for _, id in ipairs(ORDER) do
		if REGISTRY[id].rarity >= minRarity then
			table.insert(result, id)
		end
	end
	return result
end

-- -----------------------------------------------------------------------------
-- Roblox datatype conversion. Only call these from inside Roblox (client/server).
-- -----------------------------------------------------------------------------

function AuraRegistry.ToColor3(rgb: RGB): Color3
	return Color3.fromRGB(rgb.r, rgb.g, rgb.b)
end

function AuraRegistry.Materialize(id: string): MaterializedAura?
	local cached = materializedCache[id]
	if cached ~= nil then
		return cached
	end

	local config = REGISTRY[id]
	if config == nil then
		return nil
	end

	local primary = Color3.fromRGB(config.primary.r, config.primary.g, config.primary.b)
	local secondary = Color3.fromRGB(config.secondary.r, config.secondary.g, config.secondary.b)
	local rim = Color3.fromRGB(config.rim.r, config.rim.g, config.rim.b)

	local materialized: MaterializedAura = {
		config = config,
		primary = primary,
		secondary = secondary,
		rim = rim,

		shardSize = Vector3.new(config.shardSize.x, config.shardSize.y, config.shardSize.z),
		shardPartType = resolveShardShapes()[config.shardShape],
		shardColorA = primary,
		shardColorB = secondary,

		trailColor = ColorSequence.new({
			ColorSequenceKeypoint.new(0, primary),
			ColorSequenceKeypoint.new(1, secondary),
		}),
		trailWidth = NumberSequence.new({
			NumberSequenceKeypoint.new(0, config.trailWidthStart),
			NumberSequenceKeypoint.new(1, config.trailWidthEnd),
		}),
		trailTransparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, config.trailTransparencyStart),
			NumberSequenceKeypoint.new(1, 1),
		}),

		particleColor = ColorSequence.new({
			ColorSequenceKeypoint.new(0, primary),
			ColorSequenceKeypoint.new(0.55, secondary),
			ColorSequenceKeypoint.new(1, rim),
		}),
		particleSize = NumberSequence.new({
			NumberSequenceKeypoint.new(0, config.particleSizeStart),
			NumberSequenceKeypoint.new(1, config.particleSizeEnd),
		}),
		particleTransparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, config.particleTransparencyStart),
			NumberSequenceKeypoint.new(0.7, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		}),
		particleSpeed = NumberRange.new(config.particleSpeedMin, config.particleSpeedMax),
		particleLifetime = NumberRange.new(config.particleLifetimeMin, config.particleLifetimeMax),

		lightColor = primary:Lerp(rim, 0.4),
		highlightDepthMode = if config.alwaysOnTop
			then Enum.HighlightDepthMode.AlwaysOnTop
			else Enum.HighlightDepthMode.Occluded,
		cutsceneFovDelta = 8 + 16 * config.cutsceneIntensity,
	}

	materializedCache[id] = materialized
	return materialized
end

-- Returns a copy so callers cannot corrupt the shared cache.
function AuraRegistry.Describe(id: string): { [string]: any }?
	local config = REGISTRY[id]
	if config == nil then
		return nil
	end
	local description: { [string]: any } = {}
	for key, value in pairs(config :: any) do
		description[key] = value
	end
	return description
end

return AuraRegistry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">RollMath</string>
          <string name="Source"><![CDATA[--!strict
--[[
	RollMath
	========
	A PURE, deterministic-testable weighted RNG selector with soft/hard pity.

	ZERO Roblox dependencies:
	  * No `game`, no `Instance`, no `typeof`, no `task`, no workspace access.
	  * The only globals used are the plain Luau standard library
	    (`math`, `table`, `string`, `pcall`, `error`, `type`, `require`).
	  * Because of that you can execute and test this file straight from a
	    terminal with Lune or the Luau CLI. `require("./AuraRegistry")` is used as
	    a fallback loader when the Roblox `script` global does not exist.

	  lune run ./test_rollmath        (or)
	  luau --interactive --path .

	RNG MODEL
	---------
	The pool is sampled with a single uniform draw against cumulative weights.

	Luck must change the *shape* of the distribution, not merely its scale. A
	weight of `luck / rarity` applied to every entry scales the whole weight
	vector by a constant, which cancels out during normalisation and would make
	luck do literally nothing. So the pool's most common aura (its "floor")
	keeps its base weight while everything rarer gets `rarity / luck`. The floor
	absorbs the difference and luck genuinely shifts odds toward the rare end.

	PITY MODEL
	----------
	  * Soft pity  : every SOFT_PITY_INTERVAL rolls without a rarity >= 50 pull,
	                 luck gains a stacking bonus of SOFT_PITY_STEP.
	  * Hard pity  : on the HARD_PITY_ROLLS-th consecutive roll the pool is
	                 restricted to auras with rarity >= HARD_PITY_MIN_RARITY,
	                 which guarantees the pull.
]]

export type RegistryEntry = {
	id: string,
	displayName: string,
	tier: string,
	rarity: number,
}

export type RegistryLike = {
	ORDER: { string },
	Get: (id: string) -> RegistryEntry?,
}

export type RandomSource = () -> number

export type Constants = {
	softPityInterval: number,
	softPityStep: number,
	maxSoftPityStacks: number,
	hardPityRolls: number,
	hardPityMinRarity: number,
	minLuck: number,
	maxLuck: number,
}

export type RollOutcome = {
	auraId: string,
	displayName: string,
	tier: string,
	rarity: number,
	chance: number, -- true probability of this aura on this roll
	oneInN: number, -- 1 / chance, after luck + pity
	luckUsed: number, -- effective luck applied to the weights
	softPityStacks: number,
	hardPityTriggered: boolean,
	rollsSinceRare: number,
	poolSize: number,
}

export type OddsEntry = {
	auraId: string,
	displayName: string,
	tier: string,
	rarity: number,
	chance: number,
	oneInN: number,
}

export type SimulationReport = {
	rolls: number,
	counts: { [string]: number },
	rarityCounts: { [number]: number },
	bestAuraId: string?,
	bestRarity: number,
	hardPityHits: number,
	longestDrought: number,
	rarePlusCount: number,
}

local CONSTANTS: Constants = {
	-- Soft pity: +100% luck for every 50 consecutive rolls without a rare.
	softPityInterval = 50,
	softPityStep = 1.0,
	maxSoftPityStacks = 5,

	-- Hard pity: the 100th consecutive roll is guaranteed rarity >= 50.
	hardPityRolls = 100,
	hardPityMinRarity = 50,

	minLuck = 0.01,
	maxLuck = 1e6,
}

-- =============================================================================
-- Registry loading (Roblox first, then Lune/Luau CLI relative require).
-- =============================================================================

local registryOverride: RegistryLike? = nil
local cachedRegistry: RegistryLike? = nil

local function loadRegistry(): RegistryLike
	local override = registryOverride
	if override ~= nil then
		return override
	end

	local cached = cachedRegistry
	if cached ~= nil then
		return cached
	end

	-- 1) Roblox: this module lives next to AuraRegistry inside ReplicatedStorage.Shared.
	local scriptGlobal: any = script
	if scriptGlobal ~= nil then
		local parent: any = scriptGlobal.Parent
		if parent ~= nil then
			local module: any = parent:FindFirstChild("AuraRegistry")
			if module ~= nil then
				local loaded: RegistryLike = require(module)
				cachedRegistry = loaded
				return loaded
			end
		end
	end

	-- 2) Lune / Luau CLI: require the sibling file by relative path.
	local dynRequire: any = require
	local ok: boolean, module: any = pcall(dynRequire, "./AuraRegistry")
	if ok and module ~= nil then
		local loaded: RegistryLike = module
		cachedRegistry = loaded
		return loaded
	end

	error(
		"RollMath: could not locate AuraRegistry. When running outside Roblox, "
			.. "call RollMath.SetRegistry(AuraRegistry) before rolling.",
		2
	)
end

-- =============================================================================
-- Internal helpers
-- =============================================================================

local function defaultRandom(): number
	return math.random()
end

local function sanitizeNumber(value: number, fallback: number, minimum: number, maximum: number): number
	if type(value) ~= "number" then
		return fallback
	end
	if value ~= value then -- NaN
		return fallback
	end
	if value < minimum then
		return minimum
	end
	if value > maximum then
		return maximum
	end
	return value
end

local function sanitizeRandom(source: RandomSource?): RandomSource
	if type(source) ~= "function" then
		return defaultRandom
	end
	return source
end

type Pool = {
	entries: { RegistryEntry },
	weights: { number },
	total: number,
	luckUsed: number,
	softPityStacks: number,
	hardPityTriggered: boolean,
}

local function buildPool(luckMultiplier: number, pityCount: number): Pool
	local registry = loadRegistry()

	local safeLuck = sanitizeNumber(luckMultiplier, 1, CONSTANTS.minLuck, CONSTANTS.maxLuck)
	local safePity = sanitizeNumber(pityCount, 0, 0, CONSTANTS.hardPityRolls * 1000)
	safePity = math.floor(safePity)

	local hardPityTriggered = (safePity + 1) >= CONSTANTS.hardPityRolls and safePity > 0
	local stacks = math.floor(safePity / CONSTANTS.softPityInterval)
	if stacks > CONSTANTS.maxSoftPityStacks then
		stacks = CONSTANTS.maxSoftPityStacks
	end
	if stacks < 0 then
		stacks = 0
	end

	-- Hard pity ignores the soft pity ramp: the pool is already restricted.
	local luckUsed = safeLuck
	if not hardPityTriggered then
		luckUsed = safeLuck * (1 + CONSTANTS.softPityStep * stacks)
	end

	local entries: { RegistryEntry } = {}
	for _, id in ipairs(registry.ORDER) do
		local entry = registry.Get(id)
		if entry ~= nil then
			if not hardPityTriggered or entry.rarity >= CONSTANTS.hardPityMinRarity then
				table.insert(entries, entry)
			end
		end
	end

	-- Degenerate registry guard: never return an empty pool.
	if #entries == 0 then
		for _, id in ipairs(registry.ORDER) do
			local entry = registry.Get(id)
			if entry ~= nil then
				table.insert(entries, entry)
			end
		end
	end

	-- Floor rarity == the most common aura in this pool. It is exempt from the
	-- luck boost so the remaining weights can actually re-normalise.
	local floorRarity = math.huge
	for _, entry in ipairs(entries) do
		if entry.rarity < floorRarity then
			floorRarity = entry.rarity
		end
	end

	local weights: { number } = table.create(#entries)
	local total = 0
	for index, entry in ipairs(entries) do
		local effectiveRarity = entry.rarity
		if entry.rarity > floorRarity then
			effectiveRarity = entry.rarity / luckUsed
		end
		if effectiveRarity < 1 then
			effectiveRarity = 1
		end

		local weight = 1 / effectiveRarity
		weights[index] = weight
		total += weight
	end

	return {
		entries = entries,
		weights = weights,
		total = total,
		luckUsed = luckUsed,
		softPityStacks = stacks,
		hardPityTriggered = hardPityTriggered,
	}
end

-- Converts a [0, 1) draw into an index. Clamps defensive values so a broken
-- RNG can never index outside the pool.
local function pickIndex(pool: Pool, roll: number): number
	local count = #pool.weights
	local draw = sanitizeNumber(roll, 0, 0, 0.9999999999)
	local target = draw * pool.total
	local cumulative = 0
	for index = 1, count do
		cumulative += pool.weights[index]
		if target < cumulative then
			return index
		end
	end
	return count
end

-- =============================================================================
-- Public API
-- =============================================================================

local RollMath = {}

RollMath.Constants = CONSTANTS

-- Test / non-Roblox seam: inject the registry that supplies ids and rarities.
function RollMath.SetRegistry(registry: RegistryLike): ()
	registryOverride = registry
	cachedRegistry = nil
end

-- Drops the cached registry so the next roll re-resolves it.
function RollMath.ResetRegistryCache(): ()
	cachedRegistry = nil
end

function RollMath.SoftPityInterval(): number
	return CONSTANTS.softPityInterval
end

function RollMath.HardPityRolls(): number
	return CONSTANTS.hardPityRolls
end

function RollMath.HardPityMinRarity(): number
	return CONSTANTS.hardPityMinRarity
end

-- Number of soft-pity stacks accumulated at the given pity count.
function RollMath.SoftPityStacks(pityCount: number): number
	local safePity = math.max(0, math.floor(sanitizeNumber(pityCount, 0, 0, 1e9)))
	local stacks = math.floor(safePity / CONSTANTS.softPityInterval)
	if stacks > CONSTANTS.maxSoftPityStacks then
		return CONSTANTS.maxSoftPityStacks
	end
	return stacks
end

-- Luck multiplier contributed by soft pity alone (1.0 when inactive).
function RollMath.SoftPityMultiplier(pityCount: number): number
	return 1 + CONSTANTS.softPityStep * RollMath.SoftPityStacks(pityCount)
end

function RollMath.IsSoftPityActive(pityCount: number): boolean
	return RollMath.SoftPityStacks(pityCount) > 0
end

-- How many more rolls until the guaranteed rarity >= 50 pull. 0 == this roll.
function RollMath.RollsUntilGuaranteed(pityCount: number): number
	local safePity = math.max(0, math.floor(sanitizeNumber(pityCount, 0, 0, 1e9)))
	return math.max(0, CONSTANTS.hardPityRolls - (safePity + 1))
end

-- True when the *next* roll will be a guaranteed rarity >= 50 pull.
function RollMath.IsHardPityNext(pityCount: number): boolean
	return RollMath.RollsUntilGuaranteed(pityCount) == 0
end

--[[
	SelectAura(luckMultiplier, pityCount [, random])

	Pure weighted selection. `pityCount` is the number of consecutive rolls since
	the last aura with rarity >= HARD_PITY_MIN_RARITY.

	`random` is an injected 0..1 source; pass a deterministic generator for
	reproducible tests (see `RollMath.SequenceRandom`).

	Returns the full `RollOutcome` plus the raw registry entry that was drawn.
]]
function RollMath.SelectAura(
	luckMultiplier: number,
	pityCount: number,
	random: RandomSource?
): (RollOutcome, RegistryEntry)
	local pool = buildPool(luckMultiplier, pityCount)
	local source = sanitizeRandom(random)
	local index = pickIndex(pool, source())

	local chosen = pool.entries[index]
	local chance = pool.weights[index] / pool.total
	if chance <= 0 then
		chance = 1 / #pool.entries
	end

	local outcome: RollOutcome = {
		auraId = chosen.id,
		displayName = chosen.displayName,
		tier = chosen.tier,
		rarity = chosen.rarity,
		chance = chance,
		oneInN = 1 / chance,
		luckUsed = pool.luckUsed,
		softPityStacks = pool.softPityStacks,
		hardPityTriggered = pool.hardPityTriggered,
		rollsSinceRare = math.max(0, math.floor(sanitizeNumber(pityCount, 0, 0, 1e9))),
		poolSize = #pool.entries,
	}

	return outcome, chosen
end

--[[
	ChanceTable(luckMultiplier, pityCount)

	Every aura's real probability for the *next* roll, rarest first. Purely
	informational - useful for odds panels and for asserting pity behaviour.
]]
function RollMath.ChanceTable(luckMultiplier: number, pityCount: number): { OddsEntry }
	local pool = buildPool(luckMultiplier, pityCount)
	local table_: { OddsEntry } = table.create(#pool.entries)

	for index, entry in ipairs(pool.entries) do
		local chance = pool.weights[index] / pool.total
		table.insert(table_, {
			auraId = entry.id,
			displayName = entry.displayName,
			tier = entry.tier,
			rarity = entry.rarity,
			chance = chance,
			oneInN = if chance > 0 then 1 / chance else math.huge,
		})
	end

	table.sort(table_, function(left: OddsEntry, right: OddsEntry): boolean
		return left.chance > right.chance
	end)

	return table_
end

-- Probability of pulling anything at rarity >= minRarity on the next roll.
function RollMath.ChanceOfAtLeast(minRarity: number, luckMultiplier: number, pityCount: number): number
	local odds = RollMath.ChanceTable(luckMultiplier, pityCount)
	local total = 0
	for _, entry in ipairs(odds) do
		if entry.rarity >= minRarity then
			total += entry.chance
		end
	end
	return total
end

--[[
	Deterministic 0..1 generator for tests: a plain LCG so the same seed always
	produces the same sequence of rolls on every machine.
]]
function RollMath.SequenceRandom(seed: number?): RandomSource
	local state = math.floor(sanitizeNumber(seed, 0, 0, 2 ^ 31 - 1))
	if state <= 0 then
		state = 20260114
	end

	return function(): number
		-- Numerical Recipes LCG: state = 1664525*state + 1013904223 (mod 2^32)
		state = (1664525 * state + 1013904223) % 4294967296
		return state / 4294967296
	end
end

--[[
	Simulate(rollCount, luckMultiplier?, random?)

	Runs the real pity state machine for `rollCount` rolls and reports the
	distribution. This is the function the terminal test harness exercises, and
	it is also handy for balancing tiers without launching Roblox.
]]
function RollMath.Simulate(rollCount: number, luckMultiplier: number?, random: RandomSource?): SimulationReport
	local total = math.max(0, math.floor(sanitizeNumber(rollCount, 0, 0, 1e9)))
	local luck = sanitizeNumber(luckMultiplier, 1, CONSTANTS.minLuck, CONSTANTS.maxLuck)
	local source = sanitizeRandom(random)

	local counts: { [string]: number } = {}
	local rarityCounts: { [number]: number } = {}
	local pity = 0
	local drought = 0
	local longestDrought = 0
	local hardPityHits = 0
	local rarePlusCount = 0
	local bestRarity = 0
	local bestAuraId: string? = nil

	for _ = 1, total do
		local outcome = RollMath.SelectAura(luck, pity, source)

		counts[outcome.auraId] = (counts[outcome.auraId] or 0) + 1
		rarityCounts[outcome.rarity] = (rarityCounts[outcome.rarity] or 0) + 1

		if outcome.hardPityTriggered then
			hardPityHits += 1
		end

		if outcome.rarity > bestRarity then
			bestRarity = outcome.rarity
			bestAuraId = outcome.auraId
		end

		if outcome.rarity >= CONSTANTS.hardPityMinRarity then
			rarePlusCount += 1
			pity = 0
			if drought > longestDrought then
				longestDrought = drought
			end
			drought = 0
		else
			pity += 1
			drought += 1
		end
	end

	if drought > longestDrought then
		longestDrought = drought
	end

	return {
		rolls = total,
		counts = counts,
		rarityCounts = rarityCounts,
		bestAuraId = bestAuraId,
		bestRarity = bestRarity,
		hardPityHits = hardPityHits,
		longestDrought = longestDrought,
		rarePlusCount = rarePlusCount,
	}
end

return RollMath
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="6">
        <Properties>
          <string name="Name">RNGService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
	RNGService (server)
	===================
	AUTHORITATIVE side of the aura collector.

	Responsibilities:
	  * Build the Remotes folder (RequestRoll / RollBroadcast / ToggleAutoRoll /
	    EquipAura / StateSync) programmatically in ReplicatedStorage. Nothing is
	    expected to pre-exist in the place file.
	  * Own every piece of game state: total rolls, pity counter, luck, inventory,
	    equipped aura and last roll timestamp.
	  * Enforce the roll cooldown, run the auto-roll clock and resolve every roll
	    through RollMath.
	  * Persist through a DataStore wrapper with an in-memory fallback so local
	    playtests never error and nothing is ever lost during a session.

	HARD RULE: this script never touches visuals. It creates no particles, no
	parts, no highlights and never connects RenderStepped. It publishes intent
	through `Player:SetAttribute("EquippedAura", id)` plus RemoteEvents, and the
	client renders at 60 FPS.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")

-- =============================================================================
-- Shared modules
-- =============================================================================

local sharedInstance = ReplicatedStorage:WaitForChild("Shared", 30)
if sharedInstance == nil then
	error("[RNGService] ReplicatedStorage.Shared is missing. Is `rojo serve` syncing src/shared?")
end
local Shared = sharedInstance :: Folder

local auraRegistryModule = Shared:WaitForChild("AuraRegistry", 30)
local rollMathModule = Shared:WaitForChild("RollMath", 30)
if auraRegistryModule == nil or rollMathModule == nil then
	error("[RNGService] Shared.AuraRegistry / Shared.RollMath are missing.")
end

local AuraRegistry: any = require(auraRegistryModule :: ModuleScript)
local RollMath: any = require(rollMathModule :: ModuleScript)

-- =============================================================================
-- Balance constants
-- =============================================================================

local BASE_COOLDOWN: number = 1.2
local FAST_ROLL_COOLDOWN: number = 0.6
local BASE_LUCK: number = 1.0
local INVOKE_RATE_LIMIT: number = 0.15
local BROADCAST_RARITY_THRESHOLD: number = 1000
local ROLL_LOG_INTERVAL: number = 25
local AUTOSAVE_INTERVAL: number = 90
local DATASTORE_NAME: string = "AuraCollectorSave_v1"
local SAVE_VERSION: number = 1
local MAX_INVENTORY_COUNT: number = 1e9

-- =============================================================================
-- Remotes (created procedurally - the place file starts empty)
-- =============================================================================

local existingRemotes = ReplicatedStorage:FindFirstChild("Remotes")
local remotesFolder: Folder
if existingRemotes ~= nil then
	remotesFolder = existingRemotes :: Folder
else
	local createdFolder = Instance.new("Folder") :: Folder
	createdFolder.Name = "Remotes"
	createdFolder.Parent = ReplicatedStorage
	remotesFolder = createdFolder
end

local function ensureRemote(className: string, name: string): Instance
	local existing = remotesFolder:FindFirstChild(name)
	if existing ~= nil then
		return existing
	end
	local created = Instance.new(className)
	created.Name = name
	created.Parent = remotesFolder
	return created
end

-- Roll request / acknowledgement (client -> server -> client).
local RequestRoll = ensureRemote("RemoteFunction", "RequestRoll") :: RemoteFunction
-- Roll result + global rarity announcement channel (server -> client).
local RollBroadcast = ensureRemote("RemoteEvent", "RollBroadcast") :: RemoteEvent
-- Auto-roll / fast-roll toggles (client -> server).
local ToggleAutoRoll = ensureRemote("RemoteEvent", "ToggleAutoRoll") :: RemoteEvent
-- Equip an owned aura (client -> server).
local EquipAura = ensureRemote("RemoteEvent", "EquipAura") :: RemoteEvent
-- Full player-state snapshot (server -> client).
local StateSync = ensureRemote("RemoteEvent", "StateSync") :: RemoteEvent

-- =============================================================================
-- Types
-- =============================================================================

type SavedData = {
	version: number,
	totalRolls: number,
	pityCounter: number,
	inventory: { [string]: number },
	equippedAura: string?,
	rarestAura: string?,
}

type PlayerState = {
	userId: number,
	username: string,
	loaded: boolean,
	totalRolls: number,
	pityCounter: number,
	luckMultiplier: number,
	inventory: { [string]: number },
	equippedAura: string?,
	rarestAura: string?,
	lastRollClock: number,
	lastInvokeClock: number,
	autoEnabled: boolean,
	fastEnabled: boolean,
	autoGeneration: number,

	-- Session telemetry (not persisted): lets us compare the observed rare-or-better
	-- rate against the per-roll analytic expectation while playtesting.
	rarityTally: { [number]: number },
	rarePlusPulls: number,
	hardPityHits: number,
	expectedRarePlus: number,
}

type SaveBackend = {
	kind: string,
	load: (userId: number) -> SavedData?,
	save: (userId: number, data: SavedData) -> boolean,
}

type RollPayload = {
	sequence: number,
	userId: number,
	username: string,
	auraId: string,
	displayName: string,
	tier: string,
	rarity: number,
	chance: number,
	oneInN: number,
	luckUsed: number,
	softPityStacks: number,
	hardPityTriggered: boolean,
	autoEquipped: boolean,
	ownedCount: number,
	source: string,
	global: boolean,
}

type StatePayload = {
	totalRolls: number,
	pityCounter: number,
	hardPityRolls: number,
	softPityStacks: number,
	softPityActive: boolean,
	rollsUntilGuaranteed: number,
	luckMultiplier: number,
	equippedAura: string?,
	rarestAura: string?,
	inventory: { [string]: number },
	autoEnabled: boolean,
	fastEnabled: boolean,
	cooldown: number,
	saveBackend: string,
}

-- =============================================================================
-- Persistence
-- =============================================================================

local warnedAboutDataStore = false

local function keyFor(userId: number): string
	return string.format("player_%d", userId)
end

local function newSaveTable(): SavedData
	return {
		version = SAVE_VERSION,
		totalRolls = 0,
		pityCounter = 0,
		inventory = {},
		equippedAura = nil,
		rarestAura = nil,
	}
end

local memoryStore: { [number]: SavedData } = {}

local function createMemoryBackend(): SaveBackend
	return {
		kind = "Memory(datastore-unavailable)",
		load = function(userId: number): SavedData?
			local stored = memoryStore[userId]
			if stored == nil then
				return nil
			end
			local copy = newSaveTable()
			copy.totalRolls = stored.totalRolls
			copy.pityCounter = stored.pityCounter
			copy.equippedAura = stored.equippedAura
			copy.rarestAura = stored.rarestAura
			for id, count in pairs(stored.inventory) do
				copy.inventory[id] = count
			end
			return copy
		end,
		save = function(userId: number, data: SavedData): boolean
			memoryStore[userId] = data
			return true
		end,
	}
end

local function createDataStoreBackend(): SaveBackend?
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(DATASTORE_NAME)
	end)

	if not ok or store == nil then
		warn("[RNGService] DataStore unavailable; using in-memory persistence for this session.")
		return nil
	end

	local dataStore: any = store

	return {
		kind = "DataStore",
		load = function(userId: number): SavedData?
			local success, result = pcall(function()
				return dataStore:GetAsync(keyFor(userId))
			end)
			if not success then
				if not warnedAboutDataStore then
					warnedAboutDataStore = true
					warn(
						"[RNGService] DataStore read failed (Studio API access off, or offline). "
							.. "Continuing with in-memory data."
					)
				end
				return nil
			end
			if type(result) ~= "table" then
				return nil
			end
			return result :: SavedData
		end,
		save = function(userId: number, data: SavedData): boolean
			local success = pcall(function()
				dataStore:SetAsync(keyFor(userId), data)
			end)
			if not success then
				if not warnedAboutDataStore then
					warnedAboutDataStore = true
					warn("[RNGService] DataStore write failed; data kept in memory for this session.")
				end
				return false
			end
			return true
		end,
	}
end

local activeBackend: SaveBackend
do
	local dataStoreBackend = createDataStoreBackend()
	activeBackend = if dataStoreBackend ~= nil then dataStoreBackend else createMemoryBackend()
end

-- =============================================================================
-- In-memory player state
-- =============================================================================

local playerStates: { [Player]: PlayerState } = {}
local sequenceCounter: number = 0

local function sanitizeInventory(raw: any): { [string]: number }
	local clean: { [string]: number } = {}
	if type(raw) ~= "table" then
		return clean
	end
	for key, value in pairs(raw :: { [any]: any }) do
		if type(key) == "string" and type(value) == "number" and value > 0 then
			if AuraRegistry.Get(key) ~= nil then
				local count = math.floor(value)
				if count > MAX_INVENTORY_COUNT then
					count = MAX_INVENTORY_COUNT
				end
				clean[key] = count
			end
		end
	end
	return clean
end

local function sanitizeRarityCount(value: any): number
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.max(0, math.floor(value))
end

local function sanitizeAuraId(value: any): string?
	if type(value) == "string" and AuraRegistry.Get(value) ~= nil then
		return value
	end
	return nil
end

local function buildState(player: Player, saved: SavedData?): PlayerState
	local data = saved or newSaveTable()
	local inventory = sanitizeInventory(data.inventory)

	local equipped = sanitizeAuraId(data.equippedAura)
	if equipped ~= nil and (inventory[equipped] or 0) <= 0 then
		equipped = nil
	end

	return {
		userId = player.UserId,
		username = player.Name,
		loaded = saved ~= nil,
		totalRolls = sanitizeRarityCount(data.totalRolls),
		pityCounter = math.min(sanitizeRarityCount(data.pityCounter), RollMath.HardPityRolls()),
		luckMultiplier = BASE_LUCK,
		inventory = inventory,
		equippedAura = equipped,
		rarestAura = sanitizeAuraId(data.rarestAura),
		lastRollClock = 0,
		lastInvokeClock = 0,
		autoEnabled = false,
		fastEnabled = false,
		autoGeneration = 0,
		rarityTally = {},
		rarePlusPulls = 0,
		hardPityHits = 0,
		expectedRarePlus = 0,
	}
end

local function toSavedData(state: PlayerState): SavedData
	return {
		version = SAVE_VERSION,
		totalRolls = state.totalRolls,
		pityCounter = state.pityCounter,
		inventory = state.inventory,
		equippedAura = state.equippedAura,
		rarestAura = state.rarestAura,
	}
end

-- =============================================================================
-- Helpers
-- =============================================================================

local function cooldownFor(state: PlayerState): number
	if state.fastEnabled then
		return FAST_ROLL_COOLDOWN
	end
	return BASE_COOLDOWN
end

-- Base luck plus any additive bonuses published as player attributes, so
-- passes / boosts can be granted externally without touching this script.
local function getLuckMultiplier(player: Player, state: PlayerState): number
	local luck = state.luckMultiplier

	local bonus = player:GetAttribute("LuckBonus")
	if typeof(bonus) == "number" and bonus > 0 then
		luck += bonus
	end

	if luck < 0.01 then
		luck = 0.01
	end
	return luck
end

local function rarityOfAuraId(auraId: string?): number
	if auraId == nil then
		return 0
	end
	local config = AuraRegistry.Get(auraId)
	if config == nil then
		return 0
	end
	return config.rarity
end

local function buildStatePayload(player: Player, state: PlayerState): StatePayload
	local hardPityRolls = RollMath.HardPityRolls()
	local pity = math.min(state.pityCounter, hardPityRolls)

	return {
		totalRolls = state.totalRolls,
		pityCounter = pity,
		hardPityRolls = hardPityRolls,
		softPityStacks = RollMath.SoftPityStacks(pity),
		softPityActive = RollMath.IsSoftPityActive(pity),
		rollsUntilGuaranteed = RollMath.RollsUntilGuaranteed(pity),
		luckMultiplier = getLuckMultiplier(player, state),
		equippedAura = state.equippedAura,
		rarestAura = state.rarestAura,
		inventory = state.inventory,
		autoEnabled = state.autoEnabled,
		fastEnabled = state.fastEnabled,
		cooldown = cooldownFor(state),
		saveBackend = activeBackend.kind,
	}
end

local function publishAttributes(player: Player, state: PlayerState): ()
	player:SetAttribute("EquippedAura", state.equippedAura)
	player:SetAttribute("AutoRollEnabled", state.autoEnabled)
	player:SetAttribute("FastRollEnabled", state.fastEnabled)
	player:SetAttribute("TotalRolls", state.totalRolls)
	player:SetAttribute("PityCounter", state.pityCounter)
	player:SetAttribute("LuckMultiplier", getLuckMultiplier(player, state))
	player:SetAttribute("RarestAura", state.rarestAura)
end

local function syncState(player: Player, state: PlayerState): ()
	StateSync:FireClient(player, buildStatePayload(player, state))
end

-- Publishes a roll result to its owner, and to everyone when it is rare enough
-- to be worth a global announcement. Clients de-duplicate on `sequence`.
local function publishRoll(payload: RollPayload): ()
	local roller = Players:GetPlayerByUserId(payload.userId)
	if roller ~= nil then
		RollBroadcast:FireClient(roller, payload)
	end
	if payload.global then
		RollBroadcast:FireAllClients(payload)
	end
end

-- =============================================================================
-- Balance telemetry (Studio only, never persisted)
-- =============================================================================

--[[
	Reports the observed rare-or-better rate against the summed per-roll analytic
	expectation. Over a few hundred rolls these should converge; a persistent gap
	means the pity windows or the luck model are not behaving as designed.
]]
local function logTelemetry(player: Player, state: PlayerState): ()
	if state.totalRolls == 0 then
		return
	end

	local observed = state.rarePlusPulls
	local expected = state.expectedRarePlus
	local deviation = if expected > 0 then (observed - expected) / expected * 100 else 0

	print(
		string.format(
			"[RNGService][telemetry] %s | rolls=%d rare+=%d (expected %.1f, %+.1f%%) hardPity=%d pity=%d/%d luck=%.2fx",
			player.Name,
			state.totalRolls,
			observed,
			expected,
			deviation,
			state.hardPityHits,
			state.pityCounter,
			RollMath.HardPityRolls(),
			getLuckMultiplier(player, state)
		)
	)

	local tally: { string } = {}
	for _, auraId in ipairs(AuraRegistry.ORDER) do
		local count = state.inventory[auraId] or 0
		if count > 0 then
			table.insert(tally, string.format("%s x%d", auraId, count))
		end
	end
	if #tally > 0 then
		print(string.format("[RNGService][telemetry] %s | owned: %s", player.Name, table.concat(tally, ", ")))
	end
end

-- =============================================================================
-- Roll resolution (the single authoritative path)
-- =============================================================================

local function resolveRoll(player: Player, state: PlayerState, source: string): RollPayload?
	local now = os.clock()
	local cooldown = cooldownFor(state)
	local elapsed = now - state.lastRollClock
	if elapsed < cooldown then
		return nil
	end
	state.lastRollClock = now

	local luck = getLuckMultiplier(player, state)
	local rareFloor = RollMath.HardPityMinRarity()

	-- Accumulate the analytic probability *before* the draw so the session's
	-- expected rare-or-better count is exact, not approximated after the fact.
	state.expectedRarePlus += RollMath.ChanceOfAtLeast(rareFloor, luck, state.pityCounter)

	local outcome = RollMath.SelectAura(luck, state.pityCounter)

	state.totalRolls += 1
	state.rarityTally[outcome.rarity] = (state.rarityTally[outcome.rarity] or 0) + 1
	if outcome.rarity >= rareFloor then
		state.rarePlusPulls += 1
	end
	if outcome.hardPityTriggered then
		state.hardPityHits += 1
	end

	-- Pity bookkeeping: reaching the guaranteed band resets the counter.
	if outcome.rarity >= RollMath.HardPityMinRarity() then
		state.pityCounter = 0
	else
		state.pityCounter = math.min(state.pityCounter + 1, RollMath.HardPityRolls() + 1)
	end

	state.inventory[outcome.auraId] = (state.inventory[outcome.auraId] or 0) + 1
	local ownedCount = state.inventory[outcome.auraId]

	if state.rarestAura == nil or outcome.rarity > rarityOfAuraId(state.rarestAura) then
		state.rarestAura = outcome.auraId
	end

	-- Quality-of-life auto equip: only ever upgrades, never downgrades a manual pick.
	local autoEquipped = false
	if state.equippedAura == nil or outcome.rarity > rarityOfAuraId(state.equippedAura) then
		state.equippedAura = outcome.auraId
		autoEquipped = true
	end

	sequenceCounter += 1

	local payload: RollPayload = {
		sequence = sequenceCounter,
		userId = player.UserId,
		username = player.Name,
		auraId = outcome.auraId,
		displayName = outcome.displayName,
		tier = outcome.tier,
		rarity = outcome.rarity,
		chance = outcome.chance,
		oneInN = outcome.oneInN,
		luckUsed = outcome.luckUsed,
		softPityStacks = outcome.softPityStacks,
		hardPityTriggered = outcome.hardPityTriggered,
		autoEquipped = autoEquipped,
		ownedCount = ownedCount,
		source = source,
		global = outcome.rarity >= BROADCAST_RARITY_THRESHOLD,
	}

	publishAttributes(player, state)
	syncState(player, state)
	publishRoll(payload)

	if RunService:IsStudio() and state.totalRolls % ROLL_LOG_INTERVAL == 0 then
		logTelemetry(player, state)
	end

	return payload
end

-- =============================================================================
-- Auto-roll clock (server driven, so it stays authoritative and cheat proof)
-- =============================================================================

local function stopAutoRoll(state: PlayerState): ()
	state.autoEnabled = false
	state.autoGeneration += 1
end

local function startAutoRoll(player: Player, state: PlayerState): ()
	state.autoEnabled = true
	state.autoGeneration += 1
	local generation = state.autoGeneration

	task.spawn(function()
		while state.autoEnabled and state.autoGeneration == generation and player.Parent == Players do
			local cooldown = cooldownFor(state)
			local elapsed = os.clock() - state.lastRollClock
			if elapsed < cooldown then
				task.wait(cooldown - elapsed)
			end

			if not state.autoEnabled or state.autoGeneration ~= generation or player.Parent ~= Players then
				break
			end

			resolveRoll(player, state, "Auto")
			task.wait(0.05)
		end
	end)
end

-- =============================================================================
-- Remote handlers
-- =============================================================================

RequestRoll.OnServerInvoke = function(player: Player, requestKind: any): any
	local state = playerStates[player]
	if state == nil then
		return { ok = false, reason = "NotReady" }
	end

	if requestKind ~= nil and type(requestKind) ~= "string" then
		return { ok = false, reason = "BadRequest" }
	end

	local now = os.clock()
	if now - state.lastInvokeClock < INVOKE_RATE_LIMIT then
		return { ok = false, reason = "RateLimited" }
	end
	state.lastInvokeClock = now

	local cooldown = cooldownFor(state)
	local elapsed = now - state.lastRollClock
	if elapsed < cooldown then
		return {
			ok = false,
			reason = "Cooldown",
			remaining = cooldown - elapsed,
		}
	end

	local payload = resolveRoll(player, state, "Manual")
	if payload == nil then
		return { ok = false, reason = "Cooldown", remaining = cooldownFor(state) }
	end

	return { ok = true, sequence = payload.sequence }
end

ToggleAutoRoll.OnServerEvent:Connect(function(player: Player, setting: any, enabled: any)
	local state = playerStates[player]
	if state == nil then
		return
	end

	if type(setting) ~= "string" or type(enabled) ~= "boolean" then
		return
	end

	if setting == "Auto" then
		if enabled then
			startAutoRoll(player, state)
		else
			stopAutoRoll(state)
		end
	elseif setting == "Fast" then
		-- Simulated pass: deliberately not validating any purchase receipt.
		state.fastEnabled = enabled
	else
		return
	end

	publishAttributes(player, state)
	syncState(player, state)
end)

EquipAura.OnServerEvent:Connect(function(player: Player, auraId: any)
	local state = playerStates[player]
	if state == nil then
		return
	end

	if type(auraId) ~= "string" then
		return
	end

	if AuraRegistry.Get(auraId) == nil then
		return
	end

	if (state.inventory[auraId] or 0) <= 0 then
		return
	end

	state.equippedAura = auraId
	publishAttributes(player, state)
	syncState(player, state)
end)

-- =============================================================================
-- Player lifecycle
-- =============================================================================

local function saveState(state: PlayerState): boolean
	return activeBackend.save(state.userId, toSavedData(state))
end

local function setupPlayer(player: Player): ()
	local state = buildState(player, nil)
	playerStates[player] = state
	publishAttributes(player, state)

	task.spawn(function()
		local saved = activeBackend.load(player.UserId)
		if player.Parent ~= Players then
			-- Player already left: still write the loaded snapshot so nothing is lost.
			if saved ~= nil then
				activeBackend.save(player.UserId, saved)
			end
			return
		end

		-- Auto-roll intentionally does NOT survive a rejoin: the client always
		-- starts idle so an AFK player is never surprised by a running clock.
		local loaded = buildState(player, saved)
		playerStates[player] = loaded

		publishAttributes(player, loaded)
		syncState(player, loaded)
	end)
end

local function teardownPlayer(player: Player): ()
	local state = playerStates[player]
	if state == nil then
		return
	end
	stopAutoRoll(state)
	saveState(state)
	if RunService:IsStudio() then
		logTelemetry(player, state)
	end
	playerStates[player] = nil
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(teardownPlayer)

for _, existingPlayer in ipairs(Players:GetPlayers()) do
	setupPlayer(existingPlayer)
end

-- Periodic autosave keeps progress safe across crashes; lifecycle saves cover
-- clean leaves.
task.spawn(function()
	while true do
		task.wait(AUTOSAVE_INTERVAL)
		for player, state in pairs(playerStates) do
			if player.Parent == Players then
				saveState(state)
			end
		end
	end
end)

game:BindToClose(function()
	for player, state in pairs(playerStates) do
		if player.Parent == Players then
			saveState(state)
		end
	end
	if activeBackend.kind ~= "DataStore" then
		task.wait(0.2)
	end
end)

if RunService:IsStudio() then
	print(
		string.format(
			"[RNGService] Ready in Studio. Aura pool: %d. Persistence: %s. Cooldown: %.2fs (fast %.2fs).",
			AuraRegistry.Count,
			activeBackend.kind,
			BASE_COOLDOWN,
			FAST_ROLL_COOLDOWN
		)
	)
end
]]></string>
        </Properties>
      </Item>
    </Item>
