local lowVfxStroke = styleActionButton(lowVfxButton, THEME.raisedHover, THEME.panelRaised, THEME.stroke)

-- -----------------------------------------------------------------------------
-- Top center: pity tracker + stats
-- -----------------------------------------------------------------------------

local topPanel = makeFrame(hud, {
	Name = "PityPanel",
	AnchorPoint = Vector2.new(0.5, 0),
