})

local pityRail = makeFrame(topPanel, {
	Name = "PityRail",
	Position = UDim2.fromOffset(16, 50),
	Size = UDim2.new(1, -32, 0, 10),
	BackgroundColor3 = Color3.fromRGB(6, 8, 13),
